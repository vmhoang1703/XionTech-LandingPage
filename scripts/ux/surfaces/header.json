{
  "name": "header",
  "story": "1.3",
  "prototype": "index.html",
  "route": "/",
  "ready": {
    "proto": "header.nav",
    "dev": "header"
  },
  "axeScope": "header",
  "shotHeight": 560,
  "widths": [1280, 1081, 1000, 600],
  "elements": [
    {
      "name": "header",
      "proto": "header.nav",
      "dev": "header"
    },
    {
      "name": "logo",
      "proto": "header .logo img",
      "dev": "header img"
    },
    {
      "name": "nav",
      "proto": "nav.menu",
      "dev": "header nav"
    },
    {
      "name": "products-trigger",
      "proto": "nav.menu .dd:nth-of-type(1) > button",
      "dev": "header nav > div:nth-of-type(1) > button"
    },
    {
      "name": "services-trigger",
      "proto": "nav.menu .dd:nth-of-type(2) > button",
      "dev": "header nav > div:nth-of-type(2) > button"
    },
    {
      "name": "news-link",
      "proto": "nav.menu > a[href='news.html']",
      "dev": "header nav > a[href='/news']"
    },
    {
      "name": "book-demo",
      "proto": "header .head-cta",
      "dev": "header a[href='/demo#form']"
    },
    {
      "name": "skip-link",
      "proto": "a.skip",
      "dev": "a.skip"
    },
    {
      "name": "mega-products",
      "proto": "nav.menu .dd:nth-of-type(1) .mega",
      "dev": "#mega-products"
    },
    {
      "name": "mega-item",
      "proto": "nav.menu .dd:nth-of-type(1) .mega > a:first-child",
      "dev": "#mega-products > a:first-child"
    },
    {
      "name": "mega-name",
      "proto": "nav.menu .dd:nth-of-type(1) .mega > a:first-child strong",
      "dev": "#mega-products > a:first-child > span > span:nth-child(1)"
    },
    {
      "name": "mega-value",
      "proto": "nav.menu .dd:nth-of-type(1) .mega > a:first-child small:not(.for)",
      "dev": "#mega-products > a:first-child > span > span:nth-child(2)"
    },
    {
      "name": "mega-for",
      "proto": "nav.menu .dd:nth-of-type(1) .mega > a:first-child small.for",
      "dev": "#mega-products > a:first-child > span > span:nth-child(3)"
    },
    {
      "name": "mega-footer",
      "proto": "nav.menu .dd:nth-of-type(1) .mega .foot",
      "dev": "#mega-products > div:last-child"
    },
    {
      "name": "mega-services",
      "proto": "nav.menu .dd:nth-of-type(2) .mega",
      "dev": "#mega-services"
    }
  ],
  "states": [
    {
      "name": "products-open",
      "minWidth": 1081,
      "proto": [
        {
          "click": "nav.menu .dd:nth-of-type(1) > button"
        },
        {
          "wait": 400
        }
      ],
      "dev": [
        {
          "click": "header nav > div:nth-of-type(1) > button"
        }
      ],
      "elements": [
        "products-trigger",
        "mega-products",
        "mega-item",
        "mega-name",
        "mega-value",
        "mega-for",
        "mega-footer"
      ]
    },
    {
      "name": "services-open",
      "minWidth": 1081,
      "proto": [
        {
          "click": "nav.menu .dd:nth-of-type(2) > button"
        },
        {
          "wait": 400
        }
      ],
      "dev": [
        {
          "click": "header nav > div:nth-of-type(2) > button"
        }
      ],
      "elements": ["services-trigger", "mega-services"]
    },
    {
      "name": "skip-focus",
      "proto": [
        {
          "press": "Tab"
        }
      ],
      "dev": [
        {
          "press": "Tab"
        }
      ],
      "elements": ["skip-link"]
    },
    {
      "name": "hover-news",
      "minWidth": 1081,
      "proto": [
        {
          "hover": "nav.menu > a[href='news.html']"
        },
        {
          "wait": 300
        }
      ],
      "dev": [
        {
          "hover": "header nav > a[href='/news']"
        },
        {
          "wait": 300
        }
      ],
      "elements": ["news-link"]
    },
    {
      "name": "keyboard-open",
      "minWidth": 1081,
      "proto": [
        {
          "focus": "nav.menu .dd:nth-of-type(1) > button"
        },
        {
          "press": "Enter"
        },
        {
          "wait": 400
        },
        {
          "press": "Tab"
        }
      ],
      "dev": [
        {
          "focus": "header nav > div:nth-of-type(1) > button"
        },
        {
          "press": "Enter"
        },
        {
          "press": "Tab"
        }
      ],
      "elements": ["products-trigger", "mega-products", "mega-item"]
    },
    {
      "name": "row-hover",
      "minWidth": 1081,
      "proto": [
        {
          "click": "nav.menu .dd:nth-of-type(1) > button"
        },
        {
          "wait": 400
        },
        {
          "hover": "nav.menu .dd:nth-of-type(1) .mega > a:first-child"
        },
        {
          "wait": 300
        }
      ],
      "dev": [
        {
          "click": "header nav > div:nth-of-type(1) > button"
        },
        {
          "hover": "#mega-products > a:first-child"
        },
        {
          "wait": 300
        }
      ],
      "elements": ["mega-item"]
    },
    {
      "name": "footer-hover",
      "minWidth": 1081,
      "proto": [
        {
          "click": "nav.menu .dd:nth-of-type(1) > button"
        },
        {
          "wait": 400
        },
        {
          "hover": "nav.menu .dd:nth-of-type(1) .mega .foot a"
        },
        {
          "wait": 300
        }
      ],
      "dev": [
        {
          "click": "header nav > div:nth-of-type(1) > button"
        },
        {
          "hover": "#mega-products > div:last-child a"
        },
        {
          "wait": 300
        }
      ],
      "elements": ["mega-footer"]
    }
  ],
  "intended": [
    {
      "element": "mega-services",
      "prop": "height",
      "note": "EXPERIENCE.md: mega menus are text only; the prototype service rows carry 40px icon tiles"
    },
    {
      "element": "skip-link",
      "prop": "borderRadius",
      "note": "SPEC 1.3 CAP-5: amber pill (prototype 10px)"
    },
    {
      "element": "book-demo",
      "prop": "x",
      "note": "DESIGN.md: tools sit on the right; below 1080px the prototype puts them after the logo (UX-Q4, Amber to confirm)"
    },
    {
      "element": "header",
      "prop": "borderBottom",
      "note": "DESIGN.md border token is 12% navy, prototype 10% (UX-Q3, Amber to confirm)"
    },
    {
      "element": "mega-name",
      "prop": "fontSize",
      "note": "DESIGN.md title-sm is 1rem, prototype 0.92rem, DESIGN also says 1.08rem (UX-Q1, Amber decides)"
    },
    {
      "element": "mega-name",
      "prop": "lineHeight",
      "note": "follows title-sm (UX-Q1)"
    },
    {
      "element": "mega-name",
      "prop": "height",
      "note": "follows title-sm (UX-Q1)"
    },
    {
      "element": "mega-value",
      "prop": "y",
      "note": "moves with the mega-name height (UX-Q1)"
    },
    {
      "element": "mega-for",
      "prop": "fontWeight",
      "note": "DESIGN.md label-sm is 500 / 0.14em, prototype 400 / 0.12em (UX-Q2, Amber decides)"
    },
    {
      "element": "mega-for",
      "prop": "letterSpacing",
      "note": "follows label-sm (UX-Q2)"
    },
    {
      "element": "mega-for",
      "prop": "lineHeight",
      "note": "follows label-sm (UX-Q2)"
    },
    {
      "element": "mega-for",
      "prop": "y",
      "note": "moves with the mega-name and mega-value heights (UX-Q1)"
    },
    {
      "element": "mega-footer",
      "prop": "gap",
      "note": "flex gap keeps the text and link apart on a narrow panel; no visible change at 660px"
    },
    {
      "element": "book-demo",
      "prop": "lineHeight",
      "note": "DESIGN.md typography.button line-height (shared .btn from Story 1.1); text moves about 1px"
    },
    {
      "element": "mega-products",
      "prop": "height",
      "note": "follows the mega-name and mega-for sizes (UX-Q1, UX-Q2)"
    },
    {
      "element": "mega-item",
      "prop": "height",
      "note": "follows the mega-name and mega-for sizes (UX-Q1, UX-Q2)"
    },
    {
      "element": "mega-footer",
      "prop": "y",
      "note": "moves with the row heights (UX-Q1, UX-Q2)"
    },
    {
      "element": "mega-item",
      "prop": "backgroundColor",
      "note": "enhance: a keyboard-focused row shows the hover fill (the prototype shows only the ring); Amber to approve with critic P3"
    }
  ],
  "shotWidths": [360, 390, 768, 1024, 1081, 1280, 1440, 1920],
  "probes": [
    {
      "name": "products-menu",
      "minWidth": 1081,
      "trigger": {
        "proto": "nav.menu .dd:nth-of-type(1) > button",
        "dev": "header nav > div:nth-of-type(1) > button"
      },
      "hover": {
        "proto": "nav.menu .dd:nth-of-type(1)",
        "dev": "header nav > div:nth-of-type(1)"
      },
      "observe": {
        "proto": "nav.menu .dd:nth-of-type(1) .mega",
        "dev": "#mega-products"
      }
    },
    {
      "name": "services-menu",
      "minWidth": 1081,
      "trigger": {
        "proto": "nav.menu .dd:nth-of-type(2) > button",
        "dev": "header nav > div:nth-of-type(2) > button"
      },
      "hover": {
        "proto": "nav.menu .dd:nth-of-type(2)",
        "dev": "header nav > div:nth-of-type(2)"
      },
      "observe": {
        "proto": "nav.menu .dd:nth-of-type(2) .mega",
        "dev": "#mega-services"
      }
    }
  ]
}
