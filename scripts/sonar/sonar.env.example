# Copy to sonar.env (gitignored) and fill in. sonar.env is per-machine/per-clone, never committed.

# --- Project ---------------------------------------------------------------
SONAR_PROJECT_KEY=xiontech-landing-page

# Path (relative to repo root) containing sonar-project.properties for this project.
SONAR_PROJECT_DIR=.

# LOCAL-ONLY: every branch is scanned against the local Docker container.
# This project never publishes to the shared XT SonarQube server, so there is
# no SONAR_HOST_URL / SONAR_TOKEN here — do not add them.

# --- What the LOCAL gate counts as "new code" -------------------------------
# SonarQube has no branch diff on Community Build: "new code" is always a point
# in time, resolved from git blame dates.
#   reference_branch - what this branch adds on top of SONAR_LOCAL_REFERENCE_BRANCH.
#                      Seeds the local project with one backdated analysis of the
#                      merge base, cached until the merge base moves.
#   previous_version - changes since the previous analysis.
#   days             - a fixed SONAR_LOCAL_NEW_CODE_DAYS window.
SONAR_LOCAL_NEW_CODE_MODE=reference_branch

# Branch the local gate diffs against — normally the branch your PRs target.
# Fetched from origin before every run so the merge base is not computed from a
# stale ref; a fetch failure warns and continues with the local copy.
SONAR_LOCAL_REFERENCE_BRANCH=develop
#SONAR_LOCAL_FETCH_REFERENCE=1

# Only used by SONAR_LOCAL_NEW_CODE_MODE=days.
#SONAR_LOCAL_NEW_CODE_DAYS=7

# --- Coverage ---------------------------------------------------------------
# Auto-detected per stack: run_coverage.sh if present, else pytest (with --cov
# pointed at this project's sonar.sources), else `npm run test:coverage`.
# Override both when a project does not fit that shape.
# A repo that fits the auto-detect shape should leave this unset:
# check_quality_gate.sh resolves the venv interpreter itself
# (.venv/Scripts/python.exe, falling back to .venv/bin/python, then the same
# two under venv/ — see PYTHON_BIN in check_quality_gate.sh) and runs
# `<python> -m pytest --cov=<sonar.sources> --cov-report=xml:coverage.xml -q`
# for you. That produces a real coverage.xml on every run, including a red
# suite: pytest-cov writes the report at session finish regardless of
# pass/fail. Set SONAR_COVERAGE_COMMAND yourself only to pin a specific
# interpreter or override the flags on your own machine.
#SONAR_COVERAGE_COMMAND="make coverage"
#SONAR_COVERAGE_REPORT=coverage.xml

# --- Local Docker instance --------------------------------------------------
# Started/managed by scripts/sonar/local_sonar.sh. One container serves every
# repo on this machine, so its admin password and analysis token live in
# ~/.sonar-prepush-gate.env, not in the repo.
# Override these only if port 9000 or these names clash on your machine.
#SONAR_LOCAL_PORT=9000
#SONAR_LOCAL_HOST_URL=http://localhost:9000
#SONAR_LOCAL_CONTAINER=sonarqube-local
#SONAR_LOCAL_NETWORK=sonar-local-net
#SONAR_LOCAL_IMAGE=sonarqube:community
#SONAR_LOCAL_STATE_FILE=$HOME/.sonar-prepush-gate.env

# --- Scanner ---------------------------------------------------------------
# The scanner runs in Docker so no local install is needed. Docker is required.
#SONAR_SCANNER_IMAGE=sonarsource/sonar-scanner-cli:latest
