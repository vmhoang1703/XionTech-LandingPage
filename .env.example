# Sanity public project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=1khn3hf4

# Sanity dataset name
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity webhook revalidation secret (server-only, ask the lead)
SANITY_REVALIDATE_SECRET=

# Contact form: the inbox that receives every request (server-only, ask the lead).
# It is the lead's company email in every environment. Never write the address in the repo.
CONTACT_INBOX=

# Contact form: the Gmail account that sends the mail (server-only, ask the lead)
GMAIL_USER=

# Contact form: an App Password of that Gmail account (server-only, ask the lead)
GMAIL_APP_PASSWORD=

# Contact form: Upstash Redis REST URL for the rate limit.
# The Vercel Upstash integration adds this name (server-only, ask the lead)
KV_REST_API_URL=

# Contact form: Upstash Redis REST token (server-only, ask the lead)
KV_REST_API_TOKEN=

# Job applications: the id of the private Vercel Blob store that keeps CVs.
# The Blob store connection in Vercel adds this name (server-only, ask the lead)
BLOB_STORE_ID=

# Job applications: the public key that checks Blob upload callbacks.
# The Blob store connection in Vercel adds this name (server-only, ask the lead)
BLOB_WEBHOOK_PUBLIC_KEY=

# Job applications: local runs also need VERCEL_OIDC_TOKEN. `vercel link` and
# `vercel env pull` write it into .env.local. It expires after about 12 hours,
# so pull again. Vercel supplies it for each request in a deployment.
# There is no BLOB_READ_WRITE_TOKEN. Never write a token value in the repo.

# Site origin for canonical, hreflang, Open Graph, JSON-LD, robots.txt and
# sitemap.xml URLs (no trailing slash). Unset: https://xiontech-hoangvu-dev.vercel.app
NEXT_PUBLIC_SITE_URL=https://xiontech-hoangvu-dev.vercel.app
