{
  "name": "xiontech-landing-page",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:fetch-base": "git fetch -q origin develop || exit 0",
    "coverage:diff": "npm run -s coverage:fetch-base && uvx diff-cover coverage/cobertura-coverage.xml --compare-branch=origin/develop --fail-under=100 && node scripts/coverage-branches.mjs origin/develop",
    "test:smoke": "playwright test --project=smoke",
    "test:a11y": "playwright test --project=a11y",
    "sonar:gate": "bash scripts/sonar/check_quality_gate.sh",
    "sonar:gate:full": "bash scripts/sonar-gate-full.sh",
    "test:skills": "bash .claude/skills/create-pr/scripts/test_pr_scripts.sh",
    "ux:parity": "node scripts/ux/parity.mjs",
    "ux:shots": "node scripts/ux/shots.mjs",
    "i18n:prototype-vi": "node scripts/i18n/prototype-vi.mjs",
    "i18n:review": "node scripts/i18n/review.mjs",
    "i18n:vi-review": "npm run i18n:review",
    "sanity:check": "node --env-file-if-exists=.env.local scripts/sanity-check.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@sanity/client": "8.9.0",
    "@sanity/webhook": "4.0.4",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.9",
    "next": "16.3.6",
    "nodemailer": "10.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
